#include <Arduino.h>
#include <FS.h>
#include <SPI.h>
#include <SD.h>
#include <vector>
#include "pin_config.h"
#include <iostream>

static std::vector<String> current_directory = {"/"};

static bool File_Operation_Flag = 0;

enum File_Manager_Sort
{
    File_Manager_Sort_Order = 0,
    File_Manager_Sort_Reverse
};

struct File_Manager
{
    String file_name;
    size_t file_size;
};

